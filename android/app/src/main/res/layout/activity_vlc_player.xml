<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- VLC Native Video Surface Layout -->
    <org.videolan.libvlc.util.VLCVideoLayout
        android:id="@+id/vlc_video_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Touch Gesture Overlay (Single/Double Tap, Brightness/Volume swipe) -->
    <View
        android:id="@+id/touch_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Paused Dimmer Overlay (35% black) matching PlayerView.qml line 316 -->
    <View
        android:id="@+id/paused_dimmer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#59000000"
        android:visibility="gone" />

    <!-- Center Big Play Button (96x96 circle) matching PlayerView.qml line 440 -->
    <FrameLayout
        android:id="@+id/btn_center_play"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:layout_gravity="center"
        android:background="@drawable/bg_center_play"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <ImageView
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="center"
            android:layout_marginStart="3dp"
            android:src="@drawable/ic_player_play" />
    </FrameLayout>

    <!-- Centered Buffering Indicator with Percentage matching PlayerView.qml line 482 -->
    <LinearLayout
        android:id="@+id/layout_buffering"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/buffering_progress"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:indeterminateTint="#5865F2" />

        <TextView
            android:id="@+id/tv_buffering_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_osd_pill"
            android:text="Buffering"
            android:textColor="#E6FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Centered OSD / Toast matching PlayerView.qml line 506 -->
    <FrameLayout
        android:id="@+id/layout_osd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_osd_pill"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_osd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Volume 120%" />
    </FrameLayout>

    <!-- Controls Overlay (Top Header + Bottom Transport) -->
    <RelativeLayout
        android:id="@+id/layout_controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- =========================================================================
             Top Bar: Gradient + Back Button + NOW PLAYING + Title + Quality Badge + Mirrors
             ========================================================================= -->
        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_alignParentTop="true"
            android:background="#CC000000"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="24dp"
            android:paddingTop="16dp"
            android:paddingEnd="28dp"
            android:paddingBottom="16dp">

            <!-- Back Button matching PlayerView.qml line 356 -->
            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_round_button"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_player_back" />

            <!-- Title & NOW PLAYING Block -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.15"
                    android:text="NOW PLAYING"
                    android:textColor="#5865F2"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_player_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        tools:text="[Rapta] Cyberpunk Edgerunners - S01E08 [Dual Audio][1080p NF WEBRip x265 HEVC..." />

                    <!-- Quality Badge matching PlayerView.qml line 404 -->
                    <TextView
                        android:id="@+id/tv_player_quality"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:background="@drawable/bg_badge_pill"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="1080p" />
                </LinearLayout>
            </LinearLayout>

            <!-- Mirror / Source Switcher Pills -->
            <HorizontalScrollView
                android:id="@+id/scroll_sources"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layout_sources"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- =========================================================================
             Bottom Transport Bar: Full-width Seek Bar + Button Row below
             ========================================================================= -->
        <LinearLayout
            android:id="@+id/bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="#E6000000"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingTop="12dp"
            android:paddingEnd="28dp"
            android:paddingBottom="20dp">

            <!-- Full-width Seek Bar & Timeline matching PlaybackControls.qml line 101 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_current_time"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:gravity="start"
                    android:text="18:30"
                    android:textColor="#F2F3F5"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/player_seekbar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_marginEnd="10dp"
                    android:layout_weight="1"
                    android:max="1000"
                    android:maxHeight="5dp"
                    android:progressBackgroundTint="#4DFFFFFF"
                    android:progressTint="#5865F2"
                    android:thumbTint="#5865F2" />

                <TextView
                    android:id="@+id/tv_total_time"
                    android:layout_width="60dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:gravity="end"
                    android:text="25:38"
                    android:textColor="#949BA4"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Transport Controls Row below Seek Bar matching PlaybackControls.qml -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp">

                <!-- Left Group: Play/Pause, Rewind 10s, Forward 10s, Next Episode, Volume -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentStart="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Play/Pause Button -->
                    <ImageButton
                        android:id="@+id/btn_play_pause"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_player_pause" />

                    <!-- Replay 10s Button -->
                    <ImageButton
                        android:id="@+id/btn_replay_10"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="14dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:padding="7dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_player_replay10" />

                    <!-- Forward 10s Button -->
                    <ImageButton
                        android:id="@+id/btn_forward_10"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="14dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:padding="7dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_player_forward10" />

                    <!-- Next Episode Button matching PlaybackControls.qml line 273 -->
                    <ImageButton
                        android:id="@+id/btn_next_episode"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="14dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:padding="7dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_player_next" />

                    <!-- Volume Toggle & Slider Container -->
                    <LinearLayout
                        android:id="@+id/volume_container"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_marginStart="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btn_volume_mute"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:padding="6dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_player_volume_high" />

                        <SeekBar
                            android:id="@+id/volume_seekbar"
                            android:layout_width="90dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="4dp"
                            android:max="200"
                            android:maxHeight="4dp"
                            android:progress="100"
                            android:progressBackgroundTint="#4DFFFFFF"
                            android:progressTint="#FFFFFF"
                            android:thumbTint="#FFFFFF" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Right Group: Episodes, Audio & Subtitles, Aspect Ratio, Fullscreen -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_alignParentEnd="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Episodes Menu Button -->
                    <ImageButton
                        android:id="@+id/btn_episodes"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:padding="7dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_player_episodes" />

                    <!-- Audio & Subtitles Menu Button matching PlaybackControls.qml line 386 -->
                    <ImageButton
                        android:id="@+id/btn_tracks"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="14dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:padding="7dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_player_subtitles" />

                    <!-- Aspect Ratio / Speed Pill -->
                    <Button
                        android:id="@+id/btn_aspect"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_marginStart="14dp"
                        android:background="@drawable/bg_source_pill_inactive"
                        android:minWidth="0dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Fit"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <!-- Fullscreen Toggle Button -->
                    <ImageButton
                        android:id="@+id/btn_fullscreen"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="14dp"
                        android:background="?android:attr/selectableItemBackgroundBorderless"
                        android:padding="7dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_player_fullscreen" />
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>
    </RelativeLayout>

    <!-- =========================================================================
         Audio & Subtitles Floating Popup Card matching screenshot & PlaybackControls.qml line 412
         ========================================================================= -->
    <LinearLayout
        android:id="@+id/popup_tracks"
        android:layout_width="460dp"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="110dp"
        android:background="@drawable/bg_popup_card"
        android:elevation="24dp"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Two Columns: Audio (Left) and Subtitles (Right) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <!-- Audio Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="Audio"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:overScrollMode="never"
                    android:scrollbars="vertical">

                    <LinearLayout
                        android:id="@+id/list_audio_tracks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>
            </LinearLayout>

            <!-- Vertical Divider -->
            <View
                android:layout_width="1dp"
                android:layout_height="match_parent"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:background="#1FFFFFFF" />

            <!-- Subtitles Column -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    android:text="Subtitles"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:overScrollMode="never"
                    android:scrollbars="vertical">

                    <LinearLayout
                        android:id="@+id/list_subtitle_tracks"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>
            </LinearLayout>
        </LinearLayout>

        <!-- Horizontal Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="14dp"
            android:background="#1FFFFFFF" />

        <!-- Bottom Row: Autoplay next episode toggle matching screenshot -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Autoplay next episode"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Continue with the next file in the folder when this one ends"
                    android:textColor="#949BA4"
                    android:textSize="11sp" />
            </LinearLayout>

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_autoplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                app:thumbTint="#5865F2"
                app:trackTint="#383A40" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
