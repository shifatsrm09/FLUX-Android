<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/player_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:keepScreenOn="true">

    <!-- VLC Native Video Surface Layout -->
    <org.videolan.libvlc.util.VLCVideoLayout
        android:id="@+id/vlc_video_layout"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Touch Gesture Overlay (Single/Double Tap, Brightness/Volume swipe) -->
    <View
        android:id="@+id/touch_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Centered Buffering Indicator -->
    <LinearLayout
        android:id="@+id/layout_buffering"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/buffering_progress"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:indeterminateTint="#5865F2" />

        <TextView
            android:id="@+id/tv_buffering_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_osd_pill"
            android:text="Buffering stream..."
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Centered OSD / Toast (Volume, Brightness, Seek, Speed) -->
    <FrameLayout
        android:id="@+id/layout_osd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_osd_pill"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_osd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Volume: 120%" />
    </FrameLayout>

    <!-- Screen Lock Indicator Button (Visible when locked) -->
    <ImageButton
        android:id="@+id/btn_unlock_screen"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="center_vertical|start"
        android:layout_marginStart="24dp"
        android:background="@drawable/bg_round_button"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_player_lock_closed"
        android:visibility="gone" />

    <!-- Controls Overlay -->
    <RelativeLayout
        android:id="@+id/layout_controls"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Top Gradient Header Bar -->
        <LinearLayout
            android:id="@+id/top_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:background="#D90B0B0E"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="14dp">

            <!-- Back Button -->
            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_round_button"
                android:padding="8dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_player_back" />

            <!-- Title & NOW PLAYING Block -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.15"
                    android:text="NOW PLAYING"
                    android:textColor="#5865F2"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_player_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Oppenheimer (2023)" />

                    <TextView
                        android:id="@+id/tv_player_quality"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_badge_pill"
                        android:textColor="#FFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        tools:text="1080p" />
                </LinearLayout>
            </LinearLayout>

            <!-- Mirror / Source Switcher Pills -->
            <HorizontalScrollView
                android:id="@+id/scroll_sources"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layout_sources"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal" />
            </HorizontalScrollView>
        </LinearLayout>

        <!-- Bottom Gradient Transport Bar -->
        <LinearLayout
            android:id="@+id/bottom_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="#E60B0B0E"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="10dp"
            android:paddingEnd="20dp"
            android:paddingBottom="16dp">

            <!-- Seekbar & Time Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_current_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="00:00:00"
                    android:textColor="#DBDEE1"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <SeekBar
                    android:id="@+id/player_seekbar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_weight="1"
                    android:max="1000"
                    android:maxHeight="4dp"
                    android:progressBackgroundTint="#33FFFFFF"
                    android:progressTint="#5865F2"
                    android:thumbTint="#5865F2" />

                <TextView
                    android:id="@+id/tv_total_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:text="00:00:00"
                    android:textColor="#949BA4"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Actions Row: Replay, Play/Pause, Forward, Speed, Aspect, Lock -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <!-- Center Controls: Replay 10s, Play/Pause, Forward 10s -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btn_replay_10"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_round_button"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_player_replay10" />

                    <ImageButton
                        android:id="@+id/btn_play_pause"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:layout_marginStart="24dp"
                        android:layout_marginEnd="24dp"
                        android:background="@drawable/bg_round_button"
                        android:padding="12dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_player_pause" />

                    <ImageButton
                        android:id="@+id/btn_forward_10"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:background="@drawable/bg_round_button"
                        android:padding="10dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_player_forward10" />
                </LinearLayout>

                <!-- Right Side Controls: Speed, Aspect Ratio, Lock -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/btn_speed"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_source_pill_inactive"
                        android:minWidth="0dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="1.0x"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/btn_aspect"
                        android:layout_width="wrap_content"
                        android:layout_height="34dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_source_pill_inactive"
                        android:minWidth="0dp"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Fit"
                        android:textAllCaps="false"
                        android:textColor="#FFFFFF"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btn_lock"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="10dp"
                        android:background="@drawable/bg_round_button"
                        android:padding="9dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_player_lock_open" />
                </LinearLayout>
            </RelativeLayout>
        </LinearLayout>
    </RelativeLayout>
</FrameLayout>
